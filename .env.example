# Whimread CloudBase 环境配置模板
# 复制为 .env 后填入真实值(此文件提交 git,.env 不提交)
#
# ⚠️ 重要:此文件含敏感凭据(LLM API Key / JWT 私钥),不要提交到 git
#    .gitignore 已包含 .env

# ============================================
# CloudBase 环境 ID(三个独立环境)
# ============================================
# 初始化: tcb env create --alias whimread-dev --package baas_personal --postgresql --yes
# 解析完整 ID: tcb env list --alias whimread-dev
TCB_ENV_ID_DEV=
TCB_ENV_ID_STAGING=
TCB_ENV_ID_PROD=

# ============================================
# 设备 JWT 公私钥(RS256)
# ============================================
# 生成命令:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
# 然后把 PEM 内容(包含 -----BEGIN/-----END 行)粘贴到下面。
# 注意:JWT 私钥极其敏感,生产环境建议用 KMS。
DEVICE_JWT_PRIVATE_KEY=
DEVICE_JWT_PUBLIC_KEY=

# ============================================
# LLM 服务端 Key(运营方持有,客户端零配置)
# ============================================
# 三环境共用一个 Key 或分别配:
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL=deepseek-chat

# 各环境可覆盖:
LLM_BASE_URL_DEV=https://api.deepseek.com/v1
LLM_BASE_URL_STAGING=https://api.deepseek.com/v1
LLM_BASE_URL_PROD=https://api.deepseek.com/v1
LLM_DEFAULT_MODEL_DEV=deepseek-chat
LLM_DEFAULT_MODEL_STAGING=deepseek-chat
LLM_DEFAULT_MODEL_PROD=deepseek-chat
